# =====================================================================
# ASSISTENTE DAM - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# =====================================================================

# ---------------------------------------------------------------------
# 1. EVOLUTION API (WHATSAPP)
# ---------------------------------------------------------------------
# Instância da Evolution API para envio e recebimento de mensagens WhatsApp.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui
EVOLUTION_INSTANCE_NAME=DAM_Instance

# ---------------------------------------------------------------------
# 2. INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# ---------------------------------------------------------------------
# Chave da Google AI Studio para o Gemini 1.5/2.0 Flash / Pro (visão, áudio e function calling).
# Obter em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# ---------------------------------------------------------------------
# 3. SEGURANÇA E ISOLAMENTO DE CHAT (SECOPS)
# ---------------------------------------------------------------------
# Token estático secreto para autenticar chamadas aos Webhooks do DAM (Authorization: Bearer <TOKEN> ou apikey: <TOKEN>).
WEBHOOK_TOKEN=DamBot2026SecureKey!

# Números autorizados a interagir com o bot (separados por vírgula ou lista)
ALLOWED_PHONE_NUMBER=5571991269995
ALLOWED_PHONE_NUMBERS=5571991269995,5571983278254

# Número da conta WhatsApp Business do Bot (DAM)
BOT_PHONE_NUMBER=5571981718497

# ---------------------------------------------------------------------
# 4. GOOGLE CLOUD & FIREBASE FIRESTORE
# ---------------------------------------------------------------------
# Caminho para o JSON da conta de serviço do Firebase / Google Cloud com acesso ao Firestore.
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# ---------------------------------------------------------------------
# 5. GOOGLE CALENDAR (AGENDAS PESSOAIS DANIEL E LARI)
# ---------------------------------------------------------------------
CALENDAR_ID=danielmarinho1705@gmail.com
CALENDAR_ID_DANIEL=danielmarinho1705@gmail.com
# E-mail da agenda Google da Lari (compartilhada com a Service Account do GCP):
CALENDAR_ID_LARI=


# ---------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (MOBILIDADE E TRÂNSITO - FASE 8)
# ---------------------------------------------------------------------
# Chave de API da Google Maps Platform com Directions API habilitada.
# Obter em: https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Endereços favoritos para resolução de apelidos ("casa", "trabalho"):
USER_HOME_ADDRESS=Avenida Paulista, 1000 - Bela Vista, São Paulo - SP
USER_WORK_ADDRESS=Avenida Brigadeiro Faria Lima, 3500 - Itaim Bibi, São Paulo - SP

# ---------------------------------------------------------------------
# 7. VOICE MONKEY API (AUTOMAÇÃO RESIDENCIAL ALEXA - FASE 5)
# ---------------------------------------------------------------------
# Token da Voice Monkey para disparar rotinas e comandos de voz no ecossistema Amazon Alexa.
# Obter em: https://voicemonkey.io/
VOICE_MONKEY_API_TOKEN=seu_token_voice_monkey_aqui

# ---------------------------------------------------------------------
# 8. TMDB API (GUIA DE STREAMING ONDE ASSISTIR - FASE 14)
# ---------------------------------------------------------------------
# API Key (v3) do The Movie Database (TMDB) para consulta de catálogos de streaming no Brasil.
# Obter em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb_aqui

# ---------------------------------------------------------------------
# 9. COFRE DE SENHAS E CREDENCIAIS (CRIPTOGRAFIA AES-256 - FASE 13)
# ---------------------------------------------------------------------
# Segredo mestre para derivação PBKDF2HMAC (SHA-256) da chave de criptografia Fernet/AES.
VAULT_SECRET_KEY=sua_frase_secreta_mestra_para_o_cofre_2026

# (Opcional) Chave Fernet codificada em base64 URL-safe (32 bytes) para uso direto:
# VAULT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# 10. PAGAMENTOS E DIVISÃO DE CONTAS (PIX - FASES 11 E 18)
# ---------------------------------------------------------------------
# Chave Pix padrão do usuário para inclusão automática em divisões de restaurantes e Splitwise de viagens.
USER_PIX_KEY=seu-email-ou-cpf-ou-telefone@pix.com.br
# ---------------------------------------------------------------------
# 11. CLASH OF CLANS (SUPERCELL API - MONITORAMENTO DE RAIDS E GUERRAS)
# ---------------------------------------------------------------------
# Token Bearer obtido no portal de desenvolvedores da Supercell.
# Obter em: https://developer.clashofclans.com/
COC_API_TOKEN=seu_token_coc_aqui

# Tag do seu cla (incluindo o '#'). Ex: #XYZ123
COC_CLAN_TAG=#XYZ123

# Tag do seu jogador (incluindo o '#'). Ex: #ABC987
COC_PLAYER_TAG=#ABC987
